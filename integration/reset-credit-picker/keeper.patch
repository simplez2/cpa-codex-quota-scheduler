@@ -0,0 +1,50 @@
+package test
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"cpa-usage-keeper/internal/cpa/dto/apicall"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+)
+
+func TestSelectedResetCreditIsVerifiedAndForwarded(t *testing.T) {
+	selected := "credit-second"
+	list := `{"available_count":2,"credits":[{"id":"credit-first","reset_type":"codex_rate_limits","status":"available","expires_at":"2099-01-01T00:00:00Z"},{"id":"credit-second","reset_type":"codex_rate_limits","status":"available","expires_at":"2099-02-01T00:00:00Z"}]}`
+	caller := &recordingManagementCaller{responses: []*apicall.Response{
+		{StatusCode: 200, BodyText: list, Body: json.RawMessage(list)},
+		{StatusCode: 200, BodyText: `{"code":"reset","windows_reset":2}`, Body: json.RawMessage(`{"code":"reset","windows_reset":2}`)},
+	}}
+	provider := quota.NewCodexProvider(caller, quota.DefaultProviderConfigs().Codex).(quota.ProviderResetter)
+	_, err := provider.Reset(context.Background(), quota.ProviderInput{Identity: entities.UsageIdentity{Identity: "selected-account"}, ResetCreditID: &selected})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(caller.requests) != 2 || caller.requests[0].Method != "GET" || caller.requests[1].Method != "POST" {
+		t.Fatalf("unexpected calls: %+v", caller.requests)
+	}
+	data := caller.requests[1].Data.(map[string]string)
+	if data["credit_id"] != selected || data["redeem_request_id"] == "" {
+		t.Fatalf("selection was not forwarded: %+v", data)
+	}
+}
+
+func TestStaleOrInvalidSelectionNeverConsumesAnotherCredit(t *testing.T) {
+	for _, selected := range []string{"missing-credit", "credit-expired", "", "bad\ncredit"} {
+		t.Run(selected, func(t *testing.T) {
+			list := `{"available_count":1,"credits":[{"id":"credit-other","reset_type":"codex_rate_limits","status":"available","expires_at":"2099-01-01T00:00:00Z"},{"id":"credit-expired","reset_type":"codex_rate_limits","status":"available","expires_at":"2000-01-01T00:00:00Z"}]}`
+			caller := &recordingManagementCaller{responses: []*apicall.Response{{StatusCode: 200, BodyText: list, Body: json.RawMessage(list)}}}
+			provider := quota.NewCodexProvider(caller, quota.DefaultProviderConfigs().Codex).(quota.ProviderResetter)
+			if _, err := provider.Reset(context.Background(), quota.ProviderInput{Identity: entities.UsageIdentity{Identity: "account"}, ResetCreditID: &selected}); err == nil {
+				t.Fatal("expected rejected selection")
+			}
+			for _, request := range caller.requests {
+				if request.Method == "POST" {
+					t.Fatal("invalid selection consumed a credit")
+				}
+			}
+		})
+	}
+}
