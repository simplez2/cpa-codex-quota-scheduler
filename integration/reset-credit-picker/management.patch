diff --git a/src/features/quota/providers/codex/resetCreditConfirmation.ts b/src/features/quota/providers/codex/resetCreditConfirmation.ts
new file mode 100644
index 0000000..f01f9cd
--- /dev/null
+++ b/src/features/quota/providers/codex/resetCreditConfirmation.ts
@@ -0,0 +1,32 @@
+import { createElement } from 'react';
+import type { TFunction } from 'i18next';
+import type { CodexResetCredit } from '@/utils/quota/resetCredits';
+import { ResetCreditPicker } from './ResetCreditPicker';
+
+export function createResetCreditConfirmation(
+  name: string,
+  allCredits: CodexResetCredit[],
+  t: TFunction
+) {
+  const seen = new Set<string>();
+  const credits = allCredits.filter((credit) => {
+    if (!credit.id || credit.status !== 'available' ||
+      !Number.isFinite(Date.parse(credit.expiresAt)) ||
+      Date.parse(credit.expiresAt) <= Date.now() || seen.has(credit.id)) return false;
+    seen.add(credit.id);
+    return true;
+  }).sort((left, right) => Date.parse(left.expiresAt) - Date.parse(right.expiresAt));
+  let selectedCreditId = credits[0]?.id;
+  return {
+    message: createElement(ResetCreditPicker, {
+      name, credits, onSelect: (creditId) => { selectedCreditId = creditId; },
+    }),
+    selectedCreditId: () => {
+      if (allCredits.length > 0 && !credits.some((credit) =>
+        credit.id === selectedCreditId && Date.parse(credit.expiresAt) > Date.now())) {
+        throw new Error(t('codex_quota.reset_credit_selection_unavailable'));
+      }
+      return selectedCreditId;
+    },
+  };
+}
