+import { afterEach, expect, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import { CODEX_CONFIG } from '@/features/quota/providers/codex/data';
+import { apiCallApi, authFilesApi, type ApiCallRequest, type ApiCallResult } from '@/services/api';
+
+const originalRequest = apiCallApi.request;
+const originalReset = authFilesApi.resetCooldown;
+const t = ((key: string) => key) as TFunction;
+const result = (body: unknown): ApiCallResult => ({ statusCode: 200, header: {}, body, bodyText: JSON.stringify(body) });
+afterEach(() => { apiCallApi.request = originalRequest; authFilesApi.resetCooldown = originalReset; });
+
+test('submits selected credit_id after a fresh account-specific detail read', async () => {
+  const calls: ApiCallRequest[] = [];
+  apiCallApi.request = async (request) => {
+    calls.push(request);
+    if (request.method === 'POST') return result({ code: 'reset' });
+    if (request.url.endsWith('/rate-limit-reset-credits')) return result({ available_count: 2, credits: [
+      { id: 'first', reset_type: 'codex_rate_limits', status: 'available', expires_at: '2099-01-01T00:00:00Z' },
+      { id: 'second', reset_type: 'codex_rate_limits', status: 'available', expires_at: '2099-02-01T00:00:00Z' },
+    ] });
+    return result({ plan_type: 'team', rate_limit: {} });
+  };
+  authFilesApi.resetCooldown = async () => ({ status: 'ok', auth_index: 'account' });
+  await CODEX_CONFIG.resetQuota!({ name: 'account.json', auth_index: 'account' }, t, 'second');
+  const writes = calls.filter((call) => call.method === 'POST');
+  expect(writes).toHaveLength(1);
+  expect(JSON.parse(writes[0]!.data!)).toMatchObject({ credit_id: 'second' });
+  expect(calls[0]!.method).toBe('GET');
+  expect(calls[0]!.authIndex).toBe('account');
+});
+
+test('stale selected credit fails without a redemption request', async () => {
+  const calls: ApiCallRequest[] = [];
+  apiCallApi.request = async (request) => { calls.push(request); return result({ available_count: 1, credits: [] }); };
+  await expect(CODEX_CONFIG.resetQuota!({ name: 'account.json', auth_index: 'account' }, t, 'missing')).rejects.toThrow();
+  expect(calls.some((call) => call.method === 'POST')).toBe(false);
+});
