@@ -0,0 +1,48 @@
+import { useId, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useNotificationStore } from '@/stores';
+import type { CodexResetCredit } from '@/utils/quota/resetCredits';
+import styles from './ResetCreditPicker.module.scss';
+
+const expiryFormatter = new Intl.DateTimeFormat('sv-SE', {
+  timeZone: 'Asia/Shanghai',
+  year: 'numeric', month: '2-digit', day: '2-digit',
+  hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
+});
+
+export function ResetCreditPicker({
+  name, credits, onSelect,
+}: {
+  name: string;
+  credits: CodexResetCredit[];
+  onSelect: (creditId: string) => void;
+}) {
+  const { t } = useTranslation();
+  const group = useId();
+  const [selected, setSelected] = useState(credits[0]?.id);
+  const loading = useNotificationStore((state) => state.confirmation.isLoading);
+
+  return (
+    <div>
+      <p>{t('codex_quota.reset_confirm_message', { name })}</p>
+      {credits.length > 0 ? (
+        <fieldset className={styles.choices} disabled={loading}>
+          <legend>{t('codex_quota.reset_credit_select_hint')}</legend>
+          <div className={styles.list}>
+            {credits.map((credit, index) => (
+              <label key={credit.id} className={`${styles.choice} ${selected === credit.id ? styles.selected : ''}`}>
+                <input
+                  type="radio" name={group} value={index} checked={selected === credit.id}
+                  autoFocus={index === 0}
+                  onChange={() => { setSelected(credit.id); onSelect(credit.id); }}
+                />
+                <span>{t('codex_quota.reset_credit_number', { index: index + 1 })}</span>
+                <strong>{expiryFormatter.format(new Date(credit.expiresAt))} (GMT+8)</strong>
+              </label>
+            ))}
+          </div>
+        </fieldset>
+      ) : <p role="status">{t('codex_quota.reset_credit_details_unavailable')}</p>}
+    </div>
+  );
+}
