+	"testing"
+)
+
+func TestQuotaResetPreservesSelectedCredit(t *testing.T) {
+	provider := &quotaProviderStub{resetResponse: quota.ResetResponse{AuthIndex: "account", Code: "reset", WindowsReset: 2}}
+	router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "", OptionalProviders{Quota: provider})
+	resp := serveCredentialMutation(router, http.MethodPost, "/api/v1/quota/reset", `{"auth_index":"account","credit_id":"selected-second"}`)
+	if resp.Code != http.StatusOK || provider.resetRequest.CreditID == nil || *provider.resetRequest.CreditID != "selected-second" {
+		t.Fatalf("lost selection: status=%d request=%+v", resp.Code, provider.resetRequest)
+	}
+}
