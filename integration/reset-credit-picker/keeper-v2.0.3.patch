new file mode 100644
index 0000000..1a9de86
--- /dev/null
+++ b/web/src/components/usage/credentials/resetCreditSelection.ts
@@ -0,0 +1,10 @@
+import type { UsageQuotaResetCredit } from '@/lib/types'
+
+export function selectableResetCredits(credits: UsageQuotaResetCredit[], now = Date.now()): UsageQuotaResetCredit[] {
+  const seen = new Set<string>()
+  return credits.filter((credit) => {
+    if (!credit.id || credit.status !== 'available' || !Number.isFinite(Date.parse(credit.expiresAt)) || Date.parse(credit.expiresAt) <= now || seen.has(credit.id)) return false
+    seen.add(credit.id)
+    return true
+  }).sort((left, right) => Date.parse(left.expiresAt) - Date.parse(right.expiresAt))
+}
