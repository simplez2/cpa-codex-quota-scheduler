+func TestCodexBootstrapQuotaManagerSwitchesCredential(t *testing.T) {
+	for _, transport := range []string{"sse", "websocket"} {
+		t.Run(transport, func(t *testing.T) {
+			var exhausted, healthy *httptest.Server
+			cfg := codexBufferingConfig(true)
+			manager := cliproxyauth.NewManager(nil, nil, nil)
+			manager.SetRetryConfig(0, 0, 2)
+			req, opts := codexTestRequest()
+			if transport == "sse" {
+				exhausted = codexSSEServer(codexCreatedEvent, codexInProgressEvent, codexQuotaEvent)
+				healthy = codexSSEServer(codexCreatedEvent, codexCompletedEventBody)
+				manager.RegisterExecutor(NewCodexExecutor(cfg))
+			} else {
+				exhausted = codexWebsocketServer(t, codexCreatedEvent, codexInProgressEvent, codexQuotaEvent)
+				healthy = codexWebsocketServer(t, codexCreatedEvent, codexCompletedEventBody)
+				manager.RegisterExecutor(NewCodexWebsocketsExecutor(cfg))
+				req, opts = codexWebsocketRequest()
+			}
+			defer exhausted.Close()
+			defer healthy.Close()
+			for i, server := range []*httptest.Server{exhausted, healthy} {
+				auth := codexTestAuth(server.URL)
+				auth.ID = fmt.Sprintf("quota-failover-%s-%d", transport, i)
+				auth.Provider = "codex"
+				auth.Status = cliproxyauth.StatusActive
+				auth.Attributes["priority"] = fmt.Sprint(100 - i)
+				registry.GetGlobalRegistry().RegisterClient(auth.ID, "codex", []*registry.ModelInfo{{ID: req.Model}})
+				t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+				if _, err := manager.Register(context.Background(), auth); err != nil {
+					t.Fatal(err)
+				}
+			}
+			result, err := manager.ExecuteStream(context.Background(), []string{"codex"}, req, opts)
+			if err != nil || result == nil {
+				t.Fatalf("healthy backup must complete the same request: %v", err)
+			}
+			payload, streamErr := drainChunks(result)
+			if streamErr != nil || !strings.Contains(payload, "response.completed") || strings.Contains(payload, "usage_limit_reached") {
+				t.Fatalf("client must receive only successful backup output: %s err=%v", payload, streamErr)
+			}
+			if strings.Count(payload, `"type":"response.created"`) != 1 || strings.Contains(payload, "response.in_progress") {
+				t.Fatalf("failed credential handshake leaked: %s", payload)
+			}
+		})
+	}
