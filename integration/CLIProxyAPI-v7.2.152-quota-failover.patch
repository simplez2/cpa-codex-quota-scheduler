+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/api/handlers"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v7/sdk/config"
+	"github.com/tidwall/gjson"
+)
+
+type websocketFullTurnQuotaExecutor struct {
+	websocketPinnedFailoverExecutor
+	captureMu    sync.Mutex
+	attempted    []string
+	metadata     []map[string]any
+	quotaInChunk bool
+}
+
+func (*websocketFullTurnQuotaExecutor) Identifier() string { return "codex" }
+
+func (e *websocketFullTurnQuotaExecutor) ExecuteStream(_ context.Context, auth *coreauth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	e.captureMu.Lock()
+	e.attempted = append(e.attempted, auth.ID)
+	e.metadata = append(e.metadata, maps.Clone(opts.Metadata))
+	call := len(e.attempted)
+	e.captureMu.Unlock()
+	if auth.ID == "full-turn-auth-a" && call == 2 {
+		quotaErr := websocketPinnedFailoverStatusError{status: http.StatusTooManyRequests, msg: `{"error":{"type":"usage_limit_reached","message":"5h quota exhausted"}}`}
+		if !e.quotaInChunk {
+			return nil, quotaErr
+		}
+		chunks := make(chan coreexecutor.StreamChunk, 1)
+		chunks <- coreexecutor.StreamChunk{Err: quotaErr}
+		close(chunks)
+		return &coreexecutor.StreamResult{Chunks: chunks}, nil
+	}
+	chunks := make(chan coreexecutor.StreamChunk, 1)
+	chunks <- coreexecutor.StreamChunk{Payload: []byte(fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp-%s-%d","output":[]}}`, auth.ID, call))}
+	close(chunks)
+	return &coreexecutor.StreamResult{Chunks: chunks}, nil
+}
+
+func newWebsocketFullTurnQuotaTest(t *testing.T, quotaInChunk, backupWebsocket bool, explicitPin string) (*websocket.Conn, *websocketFullTurnQuotaExecutor, string) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	executor := &websocketFullTurnQuotaExecutor{quotaInChunk: quotaInChunk}
+	selector := coreauth.NewSessionAffinitySelector(&orderedWebsocketSelector{order: []string{"full-turn-auth-a", "full-turn-auth-b"}})
+	manager := coreauth.NewManager(nil, selector, nil)
+	manager.RegisterExecutor(executor)
+	modelName := fmt.Sprintf("full-turn-quota-%t-%t-model", quotaInChunk, backupWebsocket)
+	for _, auth := range []*coreauth.Auth{
+		{ID: "full-turn-auth-a", Provider: executor.Identifier(), Status: coreauth.StatusActive, Attributes: map[string]string{"websockets": "true"}},
+		{ID: "full-turn-auth-b", Provider: executor.Identifier(), Status: coreauth.StatusActive, Attributes: map[string]string{"websockets": fmt.Sprint(backupWebsocket)}},
+	} {
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatalf("register auth: %v", err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: modelName}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+	}
+	base := handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{Streaming: sdkconfig.StreamingConfig{BootstrapRetries: 1}}, manager)
+	handler := NewOpenAIResponsesAPIHandler(base)
+	router := gin.New()
+	router.GET("/v1/responses/ws", func(c *gin.Context) {
+		if explicitPin != "" {
+			c.Request = c.Request.WithContext(handlers.WithPinnedAuthID(c.Request.Context(), explicitPin))
+		}
+		handler.ResponsesWebsocket(c)
+	})
+	server := httptest.NewServer(router)
+	t.Cleanup(server.Close)
+	header := http.Header{"Session-Id": []string{"full-turn-quota-stable-session"}}
+	conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses/ws", header)
+	if err != nil {
+		t.Fatalf("dial websocket: %v", err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	return conn, executor, modelName
+}
+
+func TestResponsesWebsocketFullRequestQuotaFailoverKeepsSocket(t *testing.T) {
+	for _, quotaInChunk := range []bool{false, true} {
+		for _, backupWebsocket := range []bool{false, true} {
+			t.Run(fmt.Sprintf("chunk-%t-backup-ws-%t", quotaInChunk, backupWebsocket), func(t *testing.T) {
+				conn, executor, modelName := newWebsocketFullTurnQuotaTest(t, quotaInChunk, backupWebsocket, "")
+				for turn := 1; turn <= 3; turn++ {
+					request := fmt.Sprintf(`{"type":"response.create","model":%q,"input":[{"role":"user","content":"complete independent turn %d"}]}`, modelName, turn)
+					if err := conn.WriteMessage(websocket.TextMessage, []byte(request)); err != nil {
+						t.Fatalf("write full turn %d: %v", turn, err)
+					}
+					_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+					_, payload, err := conn.ReadMessage()
+					if err != nil || gjson.GetBytes(payload, "type").String() != wsEventTypeCompleted {
+						t.Fatalf("full turn %d must complete without client quota error or close: payload=%s err=%v", turn, payload, err)
+					}
+				}
+				executor.captureMu.Lock()
+				defer executor.captureMu.Unlock()
+				want := []string{"full-turn-auth-a", "full-turn-auth-a", "full-turn-auth-b", "full-turn-auth-b"}
+				if !reflect.DeepEqual(executor.attempted, want) {
+					t.Fatalf("auth attempts = %v, want %v (soft affinity then quota failover)", executor.attempted, want)
+				}
+				session := executor.metadata[0][coreexecutor.ExecutionSessionMetadataKey]
+				if session == nil || session == "" {
+					t.Fatal("missing execution session")
+				}
+				for i, metadata := range executor.metadata {
+					if pin := metadata[coreexecutor.PinnedAuthMetadataKey]; pin != nil && pin != "" {
+						t.Fatalf("full turn attempt %d has automatic hard pin %v", i, pin)
+					}
+					if metadata[coreexecutor.ExecutionSessionMetadataKey] != session {
+						t.Fatalf("execution session changed on attempt %d", i)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestResponsesWebsocketFullRequestPreservesExplicitAuthPin(t *testing.T) {
+	conn, executor, modelName := newWebsocketFullTurnQuotaTest(t, false, true, "full-turn-auth-b")
+	for turn := 0; turn < 2; turn++ {
+		request := fmt.Sprintf(`{"type":"response.create","model":%q,"input":[]}`, modelName)
+		if err := conn.WriteMessage(websocket.TextMessage, []byte(request)); err != nil {
+			t.Fatalf("write explicitly pinned turn: %v", err)
+		}
+		_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+		_, payload, err := conn.ReadMessage()
+		if err != nil || gjson.GetBytes(payload, "type").String() != wsEventTypeCompleted {
+			t.Fatalf("explicitly pinned response = %s, err=%v", payload, err)
+		}
+	}
+	executor.captureMu.Lock()
+	defer executor.captureMu.Unlock()
+	for i, metadata := range executor.metadata {
+		if executor.attempted[i] != "full-turn-auth-b" || metadata[coreexecutor.PinnedAuthMetadataKey] != "full-turn-auth-b" {
+			t.Fatalf("explicit pin lost on attempt %d: auth=%q metadata=%v", i, executor.attempted[i], metadata)
+		}
+	}
+}
+
+func TestResponsesWebsocketIncrementalQuotaFailureKeepsReplayBoundary(t *testing.T) {
+	for _, incremental := range []string{
+		`{"type":"response.create","previous_response_id":"resp-full-turn-auth-a-1","input":[{"role":"user","content":"delta"}]}`,
+		`{"type":"response.append","input":[{"role":"user","content":"delta"}]}`,
+	} {
+		t.Run(gjson.Get(incremental, "type").String(), func(t *testing.T) {
+			conn, executor, modelName := newWebsocketFullTurnQuotaTest(t, false, true, "")
+			first := fmt.Sprintf(`{"type":"response.create","model":%q,"input":[]}`, modelName)
+			if err := conn.WriteMessage(websocket.TextMessage, []byte(first)); err != nil {
+				t.Fatalf("write first turn: %v", err)
+			}
+			_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, payload, err := conn.ReadMessage(); err != nil || gjson.GetBytes(payload, "type").String() != wsEventTypeCompleted {
+				t.Fatalf("first turn response=%s err=%v", payload, err)
+			}
+			if err := conn.WriteMessage(websocket.TextMessage, []byte(incremental)); err != nil {
+				t.Fatalf("write incremental turn: %v", err)
+			}
+			_, _, err := conn.ReadMessage()
+			var closeErr *websocket.CloseError
+			if !errors.As(err, &closeErr) || closeErr.Code != websocket.CloseServiceRestart || closeErr.Text != wsHTTPReplayRequiredCloseReason {
+				t.Fatalf("incremental quota failure must request full replay, got %v", err)
+			}
+			executor.captureMu.Lock()
+			defer executor.captureMu.Unlock()
+			if want := []string{"full-turn-auth-a", "full-turn-auth-a"}; !reflect.DeepEqual(executor.attempted, want) {
+				t.Fatalf("incremental turn rotated auth: %v", executor.attempted)
+			}
+			if executor.metadata[1][coreexecutor.PinnedAuthMetadataKey] != "full-turn-auth-a" {
+				t.Fatal("incremental turn lost required auth pin")
+			}
+		})
+	}
+}
