diff --git a/internal/runtime/executor/codex_websockets_quota_disconnect_test.go b/internal/runtime/executor/codex_websockets_quota_disconnect_test.go
new file mode 100644
--- /dev/null
+++ b/internal/runtime/executor/codex_websockets_quota_disconnect_test.go
@@ -0,0 +1,224 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+const codexQuotaStatusEvent = `{"type":"error","status":429,"body":{"error":{"type":"usage_limit_reached","message":"quota reached","resets_in_seconds":120}},"headers":{"x-request-id":"quota-test"}}`
+
+const codexRateLimitStatusEvent = `{"type":"error","status":429,"error":{"type":"rate_limit_error","message":"Too many requests"},"headers":{"retry-after":"3","x-request-id":"rate-test"}}`
+
+func quotaDisconnectTestExecutor() *CodexWebsocketsExecutor {
+	executor := NewCodexWebsocketsExecutor(codexBufferingConfig(true))
+	executor.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	return executor
+}
+
+func assertQuotaDisconnectLockReleased(t *testing.T, executor *CodexWebsocketsExecutor, sessionID string) {
+	t.Helper()
+	session := executor.getOrCreateSession(sessionID)
+	if !session.reqMu.TryLock() {
+		t.Fatal("quota failure retained session request lock")
+	}
+	session.reqMu.Unlock()
+	session.activeMu.Lock()
+	defer session.activeMu.Unlock()
+	if session.activeCh != nil || session.activeBootstrapDone != nil {
+		t.Fatal("quota failure retained active bootstrap state")
+	}
+}
+
+func TestCodexQuotaWebsocketStatusBootstrapPreservesConnection(t *testing.T) {
+	server := codexWebsocketServerHoldingConnection(t, codexCreatedEvent, codexQuotaStatusEvent)
+	defer server.Close()
+	executor := quotaDisconnectTestExecutor()
+	const sessionID = "quota-status-bootstrap"
+	disconnect := executor.UpstreamDisconnectChan(sessionID)
+	req, opts := codexWebsocketRequest()
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+	result, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+	if result != nil || err == nil || statusCodeFromTestError(t, err) != http.StatusTooManyRequests {
+		t.Fatalf("quota bootstrap must return 429 without a stream: result=%v err=%v", result, err)
+	}
+	metadata, ok := err.(interface{ Headers() http.Header })
+	if !ok || metadata.Headers().Get("X-Request-Id") != "quota-test" {
+		t.Fatalf("quota failure lost upstream metadata: %v", err)
+	}
+	retry, ok := err.(interface{ RetryAfter() *time.Duration })
+	if !ok || retry.RetryAfter() == nil || *retry.RetryAfter() != 2*time.Minute {
+		t.Fatalf("quota failure lost reset hint: %v", err)
+	}
+	select {
+	case failure := <-disconnect:
+		t.Fatalf("quota attempt notified downstream disconnect: %v", failure)
+	default:
+	}
+	assertQuotaDisconnectLockReleased(t, executor, sessionID)
+}
+
+func TestCodexQuotaWebsocketGeneric429PreservesConnection(t *testing.T) {
+	server := codexWebsocketServerHoldingConnection(t, codexCreatedEvent, codexRateLimitStatusEvent)
+	defer server.Close()
+	executor := quotaDisconnectTestExecutor()
+	const sessionID = "transient-rate-bootstrap"
+	disconnect := executor.UpstreamDisconnectChan(sessionID)
+	req, opts := codexWebsocketRequest()
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+	result, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+	if result != nil || err == nil || statusCodeFromTestError(t, err) != http.StatusTooManyRequests {
+		t.Fatalf("rate rejection must remain a retryable bootstrap error: result=%v err=%v", result, err)
+	}
+	metadata, ok := err.(interface{ Headers() http.Header })
+	if !ok || metadata.Headers().Get("Retry-After") != "3" || metadata.Headers().Get("X-Request-Id") != "rate-test" {
+		t.Fatalf("transient 429 lost headers: %v", err)
+	}
+	if scoped, ok := err.(interface{ IsCredentialScoped() bool }); ok && scoped.IsCredentialScoped() {
+		t.Fatal("transient rate limit was marked as account quota exhaustion")
+	}
+	select {
+	case failure := <-disconnect:
+		t.Fatalf("transient 429 notified downstream disconnect: %v", failure)
+	default:
+	}
+	assertQuotaDisconnectLockReleased(t, executor, sessionID)
+}
+
+func TestCodexQuotaWebsocketImmediateClosePreservesConnection(t *testing.T) {
+	for _, frame := range []string{codexQuotaStatusEvent, codexRateLimitStatusEvent, codexQuotaEvent, codexOverloadEvent} {
+		t.Run(frame, func(t *testing.T) {
+			// The server closes immediately after writing the error frame. This
+			// exercises the reader EOF racing the queued bootstrap rejection.
+			server := codexWebsocketServer(t, codexCreatedEvent, codexInProgressEvent, frame)
+			defer server.Close()
+			for attempt := 0; attempt < 20; attempt++ {
+				executor := quotaDisconnectTestExecutor()
+				sessionID := fmt.Sprintf("immediate-close-%d", attempt)
+				disconnect := executor.UpstreamDisconnectChan(sessionID)
+				req, opts := codexWebsocketRequest()
+				opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+				result, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+				if result != nil || err == nil {
+					t.Fatalf("rejection became a committed stream: result=%v err=%v", result, err)
+				}
+				select {
+				case failure := <-disconnect:
+					t.Fatalf("immediate EOF beat failover decision: %v", failure)
+				default:
+				}
+				assertQuotaDisconnectLockReleased(t, executor, sessionID)
+			}
+		})
+	}
+}
+
+func TestCodexQuotaWebsocketCommittedFailureStillNotifies(t *testing.T) {
+	server := codexWebsocketServer(t, codexCreatedEvent, codexOutputAddedEvent, codexQuotaStatusEvent)
+	defer server.Close()
+	executor := quotaDisconnectTestExecutor()
+	const sessionID = "committed-quota-failure"
+	disconnect := executor.UpstreamDisconnectChan(sessionID)
+	req, opts := codexWebsocketRequest()
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+	result, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+	if result == nil || err != nil {
+		t.Fatalf("committed output must remain a stream: result=%v err=%v", result, err)
+	}
+	payload, streamErr := drainChunks(result)
+	if streamErr == nil || !strings.Contains(payload, "response.output_item.added") {
+		t.Fatalf("committed stream lost output or failure: payload=%s err=%v", payload, streamErr)
+	}
+	select {
+	case <-disconnect:
+	case <-time.After(time.Second):
+		t.Fatal("committed upstream failure no longer notifies downstream")
+	}
+	assertQuotaDisconnectLockReleased(t, executor, sessionID)
+}
+
+func TestCodexQuotaWebsocketIdleCloseStillNotifies(t *testing.T) {
+	release := make(chan struct{})
+	upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		if _, _, errRead := conn.ReadMessage(); errRead != nil {
+			return
+		}
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(codexCompletedEventBody))
+		<-release
+	}))
+	defer server.Close()
+	defer close(release)
+	executor := quotaDisconnectTestExecutor()
+	const sessionID = "idle-after-success"
+	disconnect := executor.UpstreamDisconnectChan(sessionID)
+	req, opts := codexWebsocketRequest()
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+	result, err := executor.ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+	if result == nil || err != nil {
+		t.Fatalf("successful stream failed: %v", err)
+	}
+	if _, errStream := drainChunks(result); errStream != nil {
+		t.Fatal(errStream)
+	}
+	release <- struct{}{}
+	select {
+	case <-disconnect:
+	case <-time.After(time.Second):
+		t.Fatal("idle close notification was suppressed")
+	}
+}
+
+func TestCodexQuotaWebsocketManagerSwitchesAfterImmediateClose(t *testing.T) {
+	exhausted := codexWebsocketServer(t, codexCreatedEvent, codexQuotaStatusEvent)
+	healthy := codexWebsocketServerHoldingConnection(t, codexCreatedEvent, codexCompletedEventBody)
+	defer exhausted.Close()
+	defer healthy.Close()
+	executor := quotaDisconnectTestExecutor()
+	manager := cliproxyauth.NewManager(nil, nil, nil)
+	manager.SetRetryConfig(0, 0, 2)
+	manager.RegisterExecutor(executor)
+	req, opts := codexWebsocketRequest()
+	const sessionID = "manager-status-quota-failover"
+	opts.Metadata = map[string]any{cliproxyexecutor.ExecutionSessionMetadataKey: sessionID}
+	disconnect := executor.UpstreamDisconnectChan(sessionID)
+	for index, server := range []*httptest.Server{exhausted, healthy} {
+		auth := codexTestAuth(server.URL)
+		auth.ID = fmt.Sprintf("immediate-quota-manager-%d", index)
+		auth.Provider, auth.Status = "codex", cliproxyauth.StatusActive
+		auth.Attributes["priority"] = fmt.Sprint(100 - index)
+		registry.GetGlobalRegistry().RegisterClient(auth.ID, "codex", []*registry.ModelInfo{{ID: req.Model}})
+		t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(auth.ID) })
+		if _, err := manager.Register(context.Background(), auth); err != nil {
+			t.Fatal(err)
+		}
+	}
+	result, err := manager.ExecuteStream(context.Background(), []string{"codex"}, req, opts)
+	if result == nil || err != nil {
+		t.Fatalf("same request did not reach healthy backup: %v", err)
+	}
+	payload, streamErr := drainChunks(result)
+	if streamErr != nil || !strings.Contains(payload, "response.completed") || strings.Contains(payload, "usage_limit_reached") || strings.Count(payload, `"type":"response.created"`) != 1 {
+		t.Fatalf("client received failed attempt: payload=%s err=%v", payload, streamErr)
+	}
+	select {
+	case failure := <-disconnect:
+		t.Fatalf("manager failover closed downstream: %v", failure)
+	default:
+	}
+	manager.CloseExecutionSession(sessionID)
+}
