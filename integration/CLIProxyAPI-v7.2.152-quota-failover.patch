+func TestCodexBootstrapQuotaFailover(t *testing.T) {
+	for _, transport := range []string{"sse", "websocket"} {
+		for _, afterOutput := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/afterOutput=%v", transport, afterOutput), func(t *testing.T) {
+				events := []string{codexCreatedEvent, codexInProgressEvent}
+				if afterOutput {
+					events = append(events, codexOutputAddedEvent)
+				}
+				events = append(events, codexQuotaEvent)
+				var result *cliproxyexecutor.StreamResult
+				var err error
+				if transport == "sse" {
+					server := codexSSEServer(events...)
+					defer server.Close()
+					req, opts := codexTestRequest()
+					result, err = NewCodexExecutor(codexBufferingConfig(true)).ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+				} else {
+					server := codexWebsocketServer(t, events...)
+					defer server.Close()
+					req, opts := codexWebsocketRequest()
+					result, err = NewCodexWebsocketsExecutor(codexBufferingConfig(true)).ExecuteStream(context.Background(), codexTestAuth(server.URL), req, opts)
+				}
+				if afterOutput {
+					if err != nil || result == nil {
+						t.Fatalf("committed output must not be replayed: result=%v err=%v", result, err)
+					}
+					payload, streamErr := drainChunks(result)
+					if !strings.Contains(payload, "response.output_item.added") || streamErr == nil {
+						t.Fatalf("expected output followed by quota failure: payload=%s err=%v", payload, streamErr)
+					}
+					return
+				}
+				if result != nil || err == nil {
+					t.Fatalf("quota rejection must not leak handshake: result=%v err=%v", result, err)
+				}
+				if statusCodeFromTestError(t, err) != http.StatusTooManyRequests {
+					t.Fatalf("quota status lost: %v", err)
+				}
+				quotaErr, ok := err.(statusErr)
+				if !ok || quotaErr.retryAfter == nil || *quotaErr.retryAfter <= 0 {
+					t.Fatalf("quota reset hint lost: %v", err)
+				}
+			})
+		}
+	}
+}
