+++ b/sdk/cliproxy/auth/conductor_continuity_legacy_test.go
@@ -0,0 +1,106 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type legacyPreAdmissionScheduler struct{ testContinuityScheduler }
+
+func (*legacyPreAdmissionScheduler) RequiresPreAdmissionContinuity() bool { return true }
+
+func TestLegacyContinuityPrecedesHealthyDispatchAndRecoversWithZeroNativeRetries(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(map[bool]string{false: "execute", true: "stream"}[stream], func(t *testing.T) {
+			manager := NewManager(nil, nil, nil)
+			manager.SetRetryConfig(0, 0, 0)
+			id, model := "legacy-compat-auth", "legacy-compat-model"
+			if _, err := manager.Register(context.Background(), &Auth{ID: id, Provider: "codex", Status: StatusActive}); err != nil {
+				t.Fatal(err)
+			}
+			registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: model}})
+			t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+			calls, preAdmission, recovery := 0, 0, 0
+			attempt := func() error {
+				calls++
+				if calls == 1 {
+					return codexQuotaRejectionErr{status: http.StatusTooManyRequests, msg: `{"error":{"type":"usage_limit_reached"}}`, credentialScoped: true}
+				}
+				return nil
+			}
+			manager.RegisterExecutor(&continuityTestExecutor{
+				provider: "codex",
+				execFn: func(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+					return cliproxyexecutor.Response{Payload: []byte(`{"ok":true}`)}, attempt()
+				},
+				streamFn: func(context.Context, *Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+					if err := attempt(); err != nil {
+						return nil, err
+					}
+					chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+					chunks <- cliproxyexecutor.StreamChunk{Payload: []byte(`{"type":"response.completed"}`)}
+					close(chunks)
+					return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+				},
+			})
+			manager.SetPluginScheduler(&legacyPreAdmissionScheduler{testContinuityScheduler{
+				hasContinuity: true,
+				continuityFunc: func(ctx context.Context, req pluginapi.SchedulerContinuityRequest) (pluginapi.SchedulerContinuityResponse, bool, error) {
+					if req.Phase == "pre_admission" {
+						preAdmission++
+						if calls != 0 {
+							t.Fatal("pre-admission followed dispatch")
+						}
+					} else {
+						recovery++
+						if _, _, err := manager.ResetQuota(ctx, id); err != nil {
+							t.Fatal(err)
+						}
+					}
+					return pluginapi.SchedulerContinuityResponse{Legacy: true, Decision: pluginapi.SchedulerContinuityReady}, true, nil
+				},
+			}})
+			request := cliproxyexecutor.Request{Model: model}
+			if stream {
+				result, err := manager.ExecuteStream(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{})
+				if err != nil {
+					t.Fatal(err)
+				}
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+				}
+			} else if _, err := manager.Execute(context.Background(), []string{"codex"}, request, cliproxyexecutor.Options{}); err != nil {
+				t.Fatal(err)
+			}
+			if calls != 2 || preAdmission != 1 || recovery != 1 {
+				t.Fatalf("dispatches=%d pre-admission=%d recovery=%d", calls, preAdmission, recovery)
+			}
+		})
+	}
+}
+
+func TestLegacyContinuityWireRetainsLongRecoveryBudget(t *testing.T) {
+	var legacy pluginapi.SchedulerContinuityResponse
+	if err := json.Unmarshal([]byte(`{"action":"wait","retry_after_ms":30000,"max_wait_ms":21600000}`), &legacy); err != nil {
+		t.Fatal(err)
+	}
+	if continuityResponseWaitBudget(legacy) != 6*time.Hour || continuityResponsePollInterval(legacy) != 30*time.Second {
+		t.Fatalf("legacy recovery was shortened: %+v", legacy)
+	}
+	var official pluginapi.SchedulerContinuityResponse
+	if err := json.Unmarshal([]byte(`{"decision":"wait","poll_interval_ms":30000,"wait_budget_ms":21600000}`), &official); err != nil {
+		t.Fatal(err)
+	}
+	if official.Legacy || continuityResponseWaitBudget(official) != maxContinuityWaitBudget || continuityResponsePollInterval(official) != maxContinuityPollInterval {
+		t.Fatalf("official bounds changed: %+v", official)
+	}
+}
