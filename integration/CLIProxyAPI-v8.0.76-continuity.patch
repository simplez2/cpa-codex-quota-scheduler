+func continuityResponseWaitBudget(resp pluginapi.SchedulerContinuityResponse) time.Duration {
+	if !resp.Legacy {
+		return clampContinuityWaitBudget(resp.WaitBudgetMs)
+	}
+	// Legacy deployments expose a configurable 1s-24h recovery budget. Keep
+	// the same request-wide deadline instead of silently shortening it to 120s.
+	ms := resp.WaitBudgetMs
+	if ms < 1000 {
+		ms = 1000
+	}
+	if ms > int64((24*time.Hour)/time.Millisecond) {
+		ms = int64((24 * time.Hour) / time.Millisecond)
+	}
+	return time.Duration(ms) * time.Millisecond
+}
+
+func continuityResponsePollInterval(resp pluginapi.SchedulerContinuityResponse) time.Duration {
+	if !resp.Legacy {
+		return clampContinuityPollInterval(resp.PollIntervalMs)
+	}
+	ms := resp.PollIntervalMs
+	if ms < 1000 {
+		ms = 1000
+	}
+	if ms > int64((5*time.Minute)/time.Millisecond) {
+		ms = int64((5 * time.Minute) / time.Millisecond)
+	}
+	return time.Duration(ms) * time.Millisecond
+}
