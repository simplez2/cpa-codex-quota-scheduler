+package pluginhost
+
+import (
+	"context"
+	"testing"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+type legacyContinuityCapture struct{ raw []byte }
+
+func (c *legacyContinuityCapture) Call(_ context.Context, _ string, raw []byte) ([]byte, error) {
+	c.raw = append([]byte(nil), raw...)
+	return []byte(`{"ok":true,"result":{"action":"wait","reason":"five_hour_exhausted","retry_after_ms":30000,"max_wait_ms":21600000}}`), nil
+}
+func (*legacyContinuityCapture) Shutdown() {}
+
+func TestLegacyContinuityRPCPreservesScopedIdentityAndWait(t *testing.T) {
+	client := &legacyContinuityCapture{}
+	adapter := &rpcPluginAdapter{client: client}
+	resp, err := adapter.Continuity(context.Background(), pluginapi.SchedulerContinuityRequest{
+		RequestID: "seed", Provider: "codex", Providers: []string{"codex"}, Model: "gpt-6.2-sol", Phase: "pre_output_429",
+		Options:    pluginapi.SchedulerOptions{Metadata: map[string]any{"request_lifecycle_id": "seed", "drop": make(chan struct{})}},
+		Candidates: []pluginapi.SchedulerContinuityCandidate{{ID: "credential", AuthIndex: "index", Provider: "codex"}},
+	})
+	if err != nil || !resp.Legacy || resp.Decision != pluginapi.SchedulerContinuityWait || resp.WaitBudgetMs != 21600000 || resp.PollIntervalMs != 30000 {
+		t.Fatalf("response=%+v err=%v", resp, err)
+	}
+	var wire struct {
+		Model    string                         `json:"model"`
+		Pick     pluginapi.SchedulerPickRequest `json:"pick"`
+		Previous bool                           `json:"previous_attempt_rejected_429"`
+	}
+	if err = json.Unmarshal(client.raw, &wire); err != nil {
+		t.Fatal(err)
+	}
+	if wire.Model != "gpt-6.2-sol" || wire.Pick.Model != wire.Model || !wire.Previous || len(wire.Pick.Candidates) != 1 || wire.Pick.Candidates[0].Metadata["auth_index"] != "index" {
+		t.Fatalf("wire=%s", client.raw)
+	}
+	if _, exists := wire.Pick.Options.Metadata["drop"]; exists {
+		t.Fatal("unsafe metadata reached the legacy envelope")
+	}
+}
