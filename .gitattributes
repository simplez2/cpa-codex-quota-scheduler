* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
# Unified diffs contain intentional context prefixes before tabs and blank lines.
integration/*.patch text eol=lf -whitespace
